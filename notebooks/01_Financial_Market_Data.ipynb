    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "START, END = \"2015-01-01\", \"2026-01-01\"    # END is exclusive\n",
    "\n",
    "dax = pd.read_csv(\"../data/dax_daily.csv\", index_col=0, parse_dates=True)\n",
    "dax = dax.loc[START:END]                    # keep 2015-01-01 up to 2026-01-01\n",
    "dax = dax[dax.index < END]                  # drop END itself if it is present\n",
    "\n",
    "# 1. Basic structure\n",
    "print(\"Shape:\", dax.shape)\n",
    "print(\"Range:\", dax.index.min().date(), \"to\", dax.index.max().date())\n",
    "print(\"Missing values:\", dax.isna().sum().sum())\n",
    "print(\"Sorted:\", dax.index.is_monotonic_increasing)\n",
    "print(\"Duplicate dates:\", dax.index.duplicated().sum())\n",
    "\n",
    "# 2. Price sanity\n",
    "print(\"Non-positive prices:\", (dax <= 0).sum().sum())\n",
    "print(\"High below Low:\", (dax[\"High\"] < dax[\"Low\"]).sum())\n",
    "print(\"High below Open/Close:\", (dax[\"High\"] < dax[[\"Open\", \"Close\"]].max(axis=1)).sum())\n",
    "print(\"Low above Open/Close:\", (dax[\"Low\"] > dax[[\"Open\", \"Close\"]].min(axis=1)).sum())\n",
    "\n",
    "# 3. Date gaps longer than a normal long weekend\n",
    "gaps = dax.index.to_series().diff().dt.days\n",
    "print(\"\\nDate gaps over 4 days:\")\n",
    "print(gaps[gaps > 4])\n",
    "\n",
    "# 4. Rows per year\n",
    "print(\"\\nRows per year:\")\n",
    "print(dax.groupby(dax.index.year).size())\n",
    "\n",
    "# 5. Largest daily moves\n",
    "moves = dax[\"Close\"].pct_change().dropna()\n",
    "top = moves.reindex(moves.abs().sort_values(ascending=False).index).head(10)\n",
    "print(\"\\nLargest daily moves:\")\n",
    "print((top * 100).round(2).astype(str) + \"%\")"
